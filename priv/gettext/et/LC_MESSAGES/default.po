#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:256
#: lib/phoenix_kit_web_analytics/web/sources_live.ex:80
#, elixir-autogen, elixir-format
msgid "Channel"
msgstr "Kanal"

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:286
#: lib/phoenix_kit_web_analytics/web/technology_live.ex:121
#, elixir-autogen, elixir-format
msgid "Desktop, mobile or tablet — read from the browser's description of itself, which it sends with every page."
msgstr "Lauaarvuti, mobiil või tahvel — loetud brauseri enda kirjeldusest, mille see iga lehega saadab."

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:107
#, elixir-autogen, elixir-format
msgid "Different people who opened at least one page."
msgstr "Erinevad inimesed, kes avasid vähemalt ühe lehe."

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:269
#: lib/phoenix_kit_web_analytics/web/sources_live.ex:93
#, elixir-autogen, elixir-format
msgid "Direct — no link to tell: typed in, a bookmark, an app"
msgstr "Otse — pole linki, mille järgi öelda: sisse trükitud, järjehoidja, rakendus"

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:264
#: lib/phoenix_kit_web_analytics/web/sources_live.ex:88
#, elixir-autogen, elixir-format
msgid "Email — webmail and newsletter links"
msgstr "E-post — veebimeil ja uudiskirja lingid"

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:162
#, elixir-autogen, elixir-format
msgid "High is normal for a blog post or a contact page people came for; high on a home page or a shop means people aren't going any further. Lower is usually better."
msgstr "Kõrge on tavaline blogipostituse või kontaktilehe puhul, mille pärast tuldi; kõrge avalehel või poes tähendab, et inimesed ei lähe edasi. Madalam on tavaliselt parem."

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:190
#, elixir-autogen, elixir-format
msgid "How long a page stays open on average, before the visitor moves on or leaves."
msgstr "Kui kaua leht keskmiselt avatuna püsib, enne kui külastaja edasi liigub või lahkub."

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:174
#, elixir-autogen, elixir-format
msgid "How long a visit lasts on average."
msgstr "Kui kaua külastus keskmiselt kestab."

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:123
#, elixir-autogen, elixir-format
msgid "How many times a page was opened, by all visitors together."
msgstr "Mitu korda lehti avati, kõigi külastajate peale kokku."

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:144
#, elixir-autogen, elixir-format
msgid "If they are away for more than %{minutes} minutes and come back, that starts a new visit, so one person can make several visits a day. Signing in has nothing to do with it."
msgstr "Kui inimene on eemal üle %{minutes} minuti ja tuleb tagasi, algab uus külastus, nii et üks inimene võib teha päevas mitu külastust. Sisselogimisega pole sel mingit pistmist."

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:195
#, elixir-autogen, elixir-format
msgid "It is measured when a page is left, so it covers LiveView pages (and every page once the optional client script is on)."
msgstr "Seda mõõdetakse lehelt lahkumisel, seega hõlmab see LiveView-lehti (ja kõiki lehti, kui valikuline kliendiskript on sees)."

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:176
#, elixir-autogen, elixir-format
msgid "Measured from the moment the first page opens until the visitor leaves the last one. For a visit to a single page, that's how long the page was open."
msgstr "Mõõdetakse esimese lehe avanemisest kuni viimaselt lehelt lahkumiseni. Ühe lehe külastuse puhul on see aeg, mil leht oli avatud."

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:139
#, elixir-autogen, elixir-format
msgid "One visit is everything a person does on the site in one go — from the first page they open until they leave."
msgstr "Üks külastus on kõik, mida inimene saidil ühe korraga teeb — esimesest avatud lehest kuni lahkumiseni."

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:125
#, elixir-autogen, elixir-format
msgid "Opening a page, moving to another page of the site, and reloading each count once."
msgstr "Lehe avamine, saidi teisele lehele liikumine ja uuesti laadimine loetakse igaüks üks kord."

#: lib/phoenix_kit_web_analytics/web/components.ex:140
#, elixir-autogen, elixir-format
msgid "People on the site now — open Right now"
msgstr "Inimesed praegu saidil — ava „Praegu“"

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:268
#: lib/phoenix_kit_web_analytics/web/sources_live.ex:92
#, elixir-autogen, elixir-format
msgid "Referral — any other website"
msgstr "Viide — mis tahes muu veebisait"

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:262
#: lib/phoenix_kit_web_analytics/web/sources_live.ex:86
#, elixir-autogen, elixir-format
msgid "Search — Google, Bing, DuckDuckGo, ChatGPT…"
msgstr "Otsing — Google, Bing, DuckDuckGo, ChatGPT…"

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:263
#: lib/phoenix_kit_web_analytics/web/sources_live.ex:87
#, elixir-autogen, elixir-format
msgid "Social — Facebook, Instagram, X, LinkedIn, Hacker News…"
msgstr "Sotsiaalmeedia — Facebook, Instagram, X, LinkedIn, Hacker News…"

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:222
#, elixir-autogen, elixir-format
msgid "The pages opened most often."
msgstr "Kõige sagedamini avatud lehed."

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:329
#, elixir-autogen, elixir-format
msgid "The pages visits ended on — where people left the site."
msgstr "Lehed, millel külastused lõppesid — kust inimesed saidilt lahkusid."

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:160
#, elixir-autogen, elixir-format
msgid "The share of visits that saw only one page and left."
msgstr "Nende külastuste osakaal, mis nägid ainult ühte lehte ja lahkusid."

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:238
#: lib/phoenix_kit_web_analytics/web/sources_live.ex:109
#, elixir-autogen, elixir-format
msgid "The site a visitor came from. When someone clicks a link to your site, their browser tells us the page the link was on; a campaign link's utm_source says it too."
msgstr "Sait, kust külastaja tuli. Kui keegi klõpsab lingil sinu saidile, ütleb tema brauser, millisel lehel link oli; kampaanialingi utm_source ütleb seda samuti."

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:177
#, elixir-autogen, elixir-format
msgid "Visit timeout"
msgstr "Külastuse aegumine"

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:290
#, elixir-autogen, elixir-format
msgid "Visit timeout, minutes"
msgstr "Külastuse aegumine, minutites"

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:310
#: lib/phoenix_kit_web_analytics/web/events_live.ex:128
#: lib/phoenix_kit_web_analytics/web/events_live.ex:151
#, elixir-autogen, elixir-format
msgid "Visitors: how many different people did it. Times: how often it was done in total."
msgstr "Külastajad: mitu erinevat inimest seda tegid. Korrad: mitu korda seda kokku tehti."

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:331
#, elixir-autogen, elixir-format
msgid "Visitors: how many different people left from it. Exits: how many visits ended there."
msgstr "Külastajad: mitu erinevat inimest sealt lahkus. Lahkumised: mitu külastust seal lõppes."

#: lib/phoenix_kit_web_analytics/web/components.ex:525
#, elixir-autogen, elixir-format
msgid "Visitors: how many different people. Views: how many times, counting every person's every view — one person opening a page three times is 1 visitor and 3 views."
msgstr "Külastajad: mitu erinevat inimest. Vaatamised: mitu korda, arvestades iga inimese iga vaatamist — üks inimene, kes avab lehe kolm korda, on 1 külastaja ja 3 vaatamist."

#: lib/phoenix_kit_web_analytics.ex:158
#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:133
#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:324
#: lib/phoenix_kit_web_analytics/web/session_live.ex:105
#: lib/phoenix_kit_web_analytics/web/sessions_live.ex:28
#: lib/phoenix_kit_web_analytics/web/sessions_live.ex:96
#, elixir-autogen, elixir-format
msgid "Visits"
msgstr "Külastused"

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:243
#: lib/phoenix_kit_web_analytics/web/sources_live.ex:114
#, elixir-autogen, elixir-format
msgid "Visits with neither — typed in, a bookmark, or an app that hides it — are Direct, and aren't listed here."
msgstr "Külastused, millel pole kumbagi — sisse trükitud, järjehoidja või rakendus, mis selle peidab — on Otse ega ole siin loetletud."

#: lib/phoenix_kit_web_analytics/web/components.ex:247
#, elixir-autogen, elixir-format
msgid "What does “%{title}” mean?"
msgstr "Mida tähendab „%{title}“?"

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:260
#: lib/phoenix_kit_web_analytics/web/sources_live.ex:84
#, elixir-autogen, elixir-format
msgid "Where visitors came from, grouped by kind:"
msgstr "Kust külastajad tulid, liigi järgi rühmitatuna:"

#: lib/phoenix_kit_web_analytics/web/pages_live.ex:92
#, elixir-autogen, elixir-format
msgid "All pages"
msgstr "Kõik lehed"

#: lib/phoenix_kit_web_analytics/web/technology_live.ex:84
#, elixir-autogen, elixir-format
msgid "Browser"
msgstr "Brauser"

#: lib/phoenix_kit_web_analytics/web/pages_live.ex:101
#, elixir-autogen, elixir-format
msgid "Click a page to see the overview for that page alone."
msgstr "Klõpsa lehel, et näha ülevaadet ainult selle lehe kohta."

#: lib/phoenix_kit_web_analytics/web/live_now_live.ex:182
#, elixir-autogen, elixir-format
msgid "Covers LiveView pages, which keep a live connection. Pages without one show up under Recent visits instead."
msgstr "Hõlmab LiveView-lehti, millel on püsiühendus. Ilma selleta lehed on selle asemel all „Hiljutised külastused“."

#: lib/phoenix_kit_web_analytics/web/events_live.ex:139
#, elixir-autogen, elixir-format
msgid "Event"
msgstr "Sündmus"

#: lib/phoenix_kit_web_analytics/web/events_live.ex:146
#, elixir-autogen, elixir-format
msgid "Events the site reports itself, with a name of its choosing — an order placed, a sign-up finished. They come from PhoenixKitWebAnalytics.track_event/2 in the app, or phoenixKitAnalytics(name, props) in the browser."
msgstr "Sündmused, millest sait ise teatab, enda valitud nimega — tellimus esitatud, registreerumine lõpetatud. Need tulevad rakenduses PhoenixKitWebAnalytics.track_event/2 või brauseris phoenixKitAnalytics(name, props) kaudu."

#: lib/phoenix_kit_web_analytics/web/events_live.ex:162
#, elixir-autogen, elixir-format
msgid "Every hit as it arrives, newest first — updated every %{seconds} seconds."
msgstr "Iga päring saabumise hetkel, uusimad eespool — uuendatakse iga %{seconds} sekundi järel."

#: lib/phoenix_kit_web_analytics/web/pages_live.ex:94
#, elixir-autogen, elixir-format
msgid "Every page that was opened in this period, most viewed first."
msgstr "Iga leht, mida selles perioodis avati, enim vaadatud eespool."

#: lib/phoenix_kit_web_analytics/web/sessions_live.ex:102
#, elixir-autogen, elixir-format
msgid "Every visit in this period, newest first. Open one to see everything that visitor did, in order."
msgstr "Iga külastus selles perioodis, uusimad eespool. Ava üks, et näha järjekorras kõike, mida külastaja tegi."

#: lib/phoenix_kit_web_analytics/web/pages_live.ex:177
#, elixir-autogen, elixir-format
msgid "How long the server took to build each page, on average — the time before the visitor's browser gets anything."
msgstr "Kui kaua server iga lehte keskmiselt koostas — aeg enne, kui külastaja brauser midagi saab."

#: lib/phoenix_kit_web_analytics/web/events_live.ex:141
#, elixir-autogen, elixir-format
msgid "No custom events recorded in this period."
msgstr "Selles perioodis kohandatud sündmusi ei salvestatud."

#: lib/phoenix_kit_web_analytics/web/technology_live.ex:159
#, elixir-autogen, elixir-format
msgid "Only filled when the site runs behind a CDN that says the visitor's country (Cloudflare does), or when a location lookup is configured. No IP address is ever stored."
msgstr "Täidetakse ainult siis, kui sait töötab CDN-i taga, mis ütleb külastaja riigi (Cloudflare teeb seda), või kui asukohaotsing on seadistatud. IP-aadressi ei salvestata kunagi."

#: lib/phoenix_kit_web_analytics/web/pages_live.ex:182
#, elixir-autogen, elixir-format
msgid "Only pages opened at least %{count} times in this period, so one slow first load doesn't top the list."
msgstr "Ainult lehed, mida selles perioodis avati vähemalt %{count} korda, et üks aeglane esimene laadimine ei tõuseks nimekirja tippu."

#: lib/phoenix_kit_web_analytics/web/sources_live.ex:136
#, elixir-autogen, elixir-format
msgid "Only the utm_ parameters are kept from a link's address; the rest of it is never stored."
msgstr "Lingi aadressist jäetakse alles ainult utm_-parameetrid; ülejäänut ei salvestata kunagi."

#: lib/phoenix_kit_web_analytics/web/events_live.ex:167
#, elixir-autogen, elixir-format
msgid "Page views, actions, exits (with how long the page was open) and custom events. The last column opens the whole visit."
msgstr "Lehevaatamised, tegevused, lahkumised (koos sellega, kui kaua leht avatud oli) ja kohandatud sündmused. Viimane veerg avab kogu külastuse."

#: lib/phoenix_kit_web_analytics/web/technology_live.ex:88
#, elixir-autogen, elixir-format
msgid "Read from the browser's description of itself, which it sends with every page. Nothing is measured on the visitor's device."
msgstr "Loetud brauseri enda kirjeldusest, mille see iga lehega saadab. Külastaja seadmes midagi ei mõõdeta."

#: lib/phoenix_kit_web_analytics/web/pages_live.ex:97
#, elixir-autogen, elixir-format
msgid "Share: this page's part of all page views. Time on page: how long it stayed open on average. Exits: how many visits ended on it."
msgstr "Osakaal: selle lehe osa kõigist lehevaatamistest. Aeg lehel: kui kaua see keskmiselt avatud oli. Lahkumised: mitu külastust sellel lõppes."

#: lib/phoenix_kit_web_analytics/web/technology_live.ex:101
#, elixir-autogen, elixir-format
msgid "System"
msgstr "Süsteem"

#: lib/phoenix_kit_web_analytics/web/technology_live.ex:138
#, elixir-autogen, elixir-format
msgid "The language the visitor's browser asks for first (et-EE is Estonian as used in Estonia) — usually the language of their device."
msgstr "Keel, mida külastaja brauser esimesena küsib (et-EE on eesti keel Eestis) — tavaliselt tema seadme keel."

#: lib/phoenix_kit_web_analytics/web/sources_live.ex:154
#, elixir-autogen, elixir-format
msgid "The utm_source of tagged links — who sent the visitor, in the words of whoever made the link: newsletter, facebook, partner-site."
msgstr "Märgistatud linkide utm_source — kes külastaja saatis, lingi tegija sõnadega: newsletter, facebook, partner-site."

#: lib/phoenix_kit_web_analytics/web/sessions_live.ex:107
#, elixir-autogen, elixir-format
msgid "Visitor: a signed-in user's name, otherwise Anonymous. Landed on → left from: the first and last page. Pages: pages opened. Actions: clicks, form submits and events. Duration: from the first page opening to leaving the last. Source: where the visit came from."
msgstr "Külastaja: sisseloginud kasutaja nimi, muidu Anonüümne. Saabus → lahkus: esimene ja viimane leht. Lehed: avatud lehed. Tegevused: klõpsud, vormide saatmised ja sündmused. Kestus: esimese lehe avamisest viimaselt lahkumiseni. Allikas: kust külastus tuli."

#: lib/phoenix_kit_web_analytics/web/sessions_live.ex:93
#, elixir-autogen, elixir-format
msgid "Visits by %{name}"
msgstr "Kasutaja %{name} külastused"

#: lib/phoenix_kit_web_analytics/web/sources_live.ex:131
#, elixir-autogen, elixir-format
msgid "Visits that arrived through a link tagged with utm_campaign — for example ?utm_campaign=autumn-sale in a newsletter or an ad."
msgstr "Külastused, mis tulid utm_campaign-märgisega lingi kaudu — näiteks ?utm_campaign=autumn-sale uudiskirjas või reklaamis."

#: lib/phoenix_kit_web_analytics/web/technology_live.ex:106
#, elixir-autogen, elixir-format
msgid "Windows, macOS, iOS, Android… — from the same description the browser sends."
msgstr "Windows, macOS, iOS, Android… — samast kirjeldusest, mille brauser saadab."

#: lib/phoenix_kit_web_analytics/web/live_now_live.ex:268
#, elixir-autogen, elixir-format
msgid "%{count} page open"
msgid_plural "%{count} pages open"
msgstr[0] "%{count} leht avatud"
msgstr[1] "%{count} lehte avatud"

#: lib/phoenix_kit_web_analytics/web/live_now_live.ex:205
#, elixir-autogen, elixir-format
msgid "By page"
msgstr "Lehtede kaupa"

#: lib/phoenix_kit_web_analytics/web/live_now_live.ex:196
#, elixir-autogen, elixir-format
msgid "Each visitor"
msgstr "Iga külastaja"

#: lib/phoenix_kit_web_analytics/web/live_now_live.ex:177
#, elixir-autogen, elixir-format
msgid "Every page someone has open this moment. Each visitor: one row per open page, with how long it has been open. By page: the same pages counted per page — what the site is being used for right now."
msgstr "Iga leht, mis kellelgi praegu avatud on. Iga külastaja: üks rida avatud lehe kohta, koos sellega, kui kaua see on avatud olnud. Lehtede kaupa: samad lehed loendatud lehe kaupa — milleks saiti praegu kasutatakse."

#: lib/phoenix_kit_web_analytics/web/components.ex:474
#, elixir-autogen, elixir-format
msgid "Newer"
msgstr "Uuemad"

#: lib/phoenix_kit_web_analytics/web/components.ex:482
#, elixir-autogen, elixir-format
msgid "Older"
msgstr "Vanemad"

#: lib/phoenix_kit_web_analytics/web/pages_live.ex:170
#, elixir-autogen, elixir-format
msgid "Page %{page}"
msgstr "Leht %{page}"

#: lib/phoenix_kit_web_analytics/web/session_live.ex:254
#, elixir-autogen, elixir-format
msgid "Show more"
msgstr "Näita rohkem"

#: lib/phoenix_kit_web_analytics/web/live_now_live.ex:297
#, elixir-autogen, elixir-format
msgid "The %{count} pages with the most people on them."
msgstr "%{count} lehte, millel on kõige rohkem inimesi."

#: lib/phoenix_kit_web_analytics/web/live_now_live.ex:305
#, elixir-autogen, elixir-format
msgid "Visits with any activity in the last %{minutes} minutes, most recently active first — including pages without a live connection. Open one to see what that visitor did."
msgstr "Külastused, millel oli viimase %{minutes} minuti jooksul mis tahes tegevust, viimati aktiivsed eespool — ka ilma püsiühenduseta lehed. Ava üks, et näha, mida külastaja tegi."

#: lib/phoenix_kit_web_analytics/web/session_live.ex:246
#, elixir-autogen, elixir-format
msgid "Showing the first %{count} events of this visit."
msgstr "Näidatakse selle külastuse esimest %{count} sündmust."

#: lib/phoenix_kit_web_analytics/web/session_live.ex:210
#, elixir-autogen, elixir-format
msgid "How this visitor moved the pointer, what they clicked and hovered, and how the page scrolled — played over the page as it looks today. Text, typing and form values are never recorded."
msgstr "Kuidas see külastaja kursorit liigutas, millele klõpsas ja millel peatus ning kuidas lehte keris — esitatuna lehe tänase välimuse peal. Teksti, trükkimist ega vormide väärtusi ei salvestata kunagi."

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:180
#, elixir-autogen, elixir-format
msgid "Keep recordings"
msgstr "Salvestuste säilitamine"

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:501
#, elixir-autogen, elixir-format
msgid "Keep recordings, days"
msgstr "Salvestusi säilitatakse, päeva"

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:481
#, elixir-autogen, elixir-format
msgid "Off by default. A recorded page sends a few rows a minute while someone is using it — on a busy site, record a share of visitors."
msgstr "Vaikimisi väljas. Salvestatav leht saadab kasutamise ajal mõne rea minutis — suure liiklusega saidil salvesta osa külastajatest."

#: lib/phoenix_kit_web_analytics/web/session_live.ex:220
#, elixir-autogen, elixir-format
msgid "Pause"
msgstr "Paus"

#: lib/phoenix_kit_web_analytics/web/session_live.ex:219
#, elixir-autogen, elixir-format
msgid "Play"
msgstr "Esita"

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:479
#, elixir-autogen, elixir-format
msgid "Record visits"
msgstr "Salvesta külastused"

#: lib/phoenix_kit_web_analytics/web/session_live.ex:205
#, elixir-autogen, elixir-format
msgid "Recording"
msgstr "Salvestus"

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:473
#, elixir-autogen, elixir-format
msgid "Replay a visit: where the pointer went, what was clicked and hovered, how the page scrolled. Recorded by the client script; only coordinates and element positions — never text, typing or form values. Visitors asking not to be tracked, bots and excluded paths are never recorded."
msgstr "Külastuse taasesitus: kuhu kursor liikus, millele klõpsati ja millel peatuti, kuidas lehte keriti. Salvestab kliendiskript; ainult koordinaadid ja elementide asukohad — mitte kunagi teksti, trükkimist ega vormide väärtusi. Jälgimisest keeldunud külastajaid, roboteid ja välistatud teid ei salvestata kunagi."

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:471
#, elixir-autogen, elixir-format
msgid "Session recordings"
msgstr "Külastuste salvestused"

#: lib/phoenix_kit_web_analytics/web/session_live.ex:227
#, elixir-autogen, elixir-format
msgid "The player needs JavaScript."
msgstr "Mängija vajab JavaScripti."

#: lib/phoenix_kit_web_analytics/web/session_live.ex:222
#, elixir-autogen, elixir-format
msgid "This page can't be shown behind the replay; only the pointer is drawn."
msgstr "Seda lehte ei saa taasesituse taustal näidata; joonistatakse ainult kursor."

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:179
#, elixir-autogen, elixir-format
msgid "Visitors recorded"
msgstr "Salvestatavad külastajad"

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:492
#, elixir-autogen, elixir-format
msgid "Visitors recorded, %"
msgstr "Salvestatavad külastajad, %"

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:267
#, elixir-autogen, elixir-format
msgid "Bots are recognised by the name their browser sends. This also catches ones posing as a normal browser: browsers under automation (needs the client script), page views faster than a person reads, and LiveView pages that never connected — a scraper fetching HTML runs no JavaScript."
msgstr "Roboteid tuntakse ära nime järgi, mille nende brauser saadab. See püüab kinni ka tavaliseks brauseriks maskeerunud: automatiseeritud brauserid (vajab kliendiskripti), lehevaatamised kiiremini, kui inimene loeb, ja LiveView lehed, mis kunagi ei ühendunud — HTML-i koguv kraapija JavaScripti ei käivita."

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:264
#, elixir-autogen, elixir-format
msgid "Spot bots by behaviour"
msgstr "Tuvasta robotid käitumise järgi"

#: lib/phoenix_kit_web_analytics/web/session_live.ex:96
#, elixir-autogen, elixir-format
msgid "Yes — its LiveView pages never connected (no JavaScript)"
msgstr "Jah — selle LiveView lehed ei ühendunud kunagi (JavaScripti pole)"

#: lib/phoenix_kit_web_analytics/web/session_live.ex:98
#, elixir-autogen, elixir-format
msgid "Yes — its browser says so"
msgstr "Jah — selle brauser ütleb nii"

#: lib/phoenix_kit_web_analytics/web/session_live.ex:93
#, elixir-autogen, elixir-format
msgid "Yes — pages faster than a person reads"
msgstr "Jah — lehed kiiremini, kui inimene loeb"

#: lib/phoenix_kit_web_analytics/web/session_live.ex:92
#, elixir-autogen, elixir-format
msgid "Yes — the browser was under automation"
msgstr "Jah — brauser oli automatiseeritud"

#: lib/phoenix_kit_web_analytics/web/components.ex:800
#, elixir-autogen, elixir-format
msgid "Other"
msgstr "Muu"

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:52
#, elixir-autogen, elixir-format
msgid "Some settings could not be saved. Check them and try again."
msgstr "Mõnda seadet ei saanud salvestada. Kontrolli neid ja proovi uuesti."

#: lib/phoenix_kit_web_analytics/web/dashboard_live.ex:266
#: lib/phoenix_kit_web_analytics/web/sources_live.ex:90
#, elixir-autogen, elixir-format
msgid "Paid — ad clicks, auto-tagged (gclid, msclkid…) or marked utm_medium=cpc"
msgstr "Tasuline — reklaamiklikid, automaatselt märgistatud (gclid, msclkid…) või märgitud utm_medium=cpc"

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:678
#, elixir-autogen, elixir-format
msgid "Behind a reverse proxy on the same host or network, the visitor's address is read from X-Forwarded-For (a port the proxy appends is dropped). Behind a chain — a CDN in front of a load balancer — put a plug that rewrites remote_ip (such as remote_ip) before the tracking plug."
msgstr "Samas masinas või võrgus oleva pöördproksi taga loetakse külastaja aadress X-Forwarded-For päisest (proksi lisatud port jäetakse ära). Ahela taga — CDN koormusjaoturi ees — pane jälgimis-plugi ette plug, mis kirjutab remote_ip ümber (näiteks remote_ip)."

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:227
#, elixir-autogen, elixir-format
msgid "LiveView visits from a private or loopback address — a reverse proxy, a container network, localhost in development — are not being recorded: the LiveView socket's connect_info lacks :x_headers. Add it on both transports — see Installation below."
msgstr "Privaat- või loopback-aadressilt tulevaid LiveView külastusi — pöördproksi, konteinervõrk, localhost arenduses — ei salvestata: LiveView sokli connect_info'st puudub :x_headers. Lisa see mõlemale transpordile — vaata allpool „Paigaldus“."

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:398
#, elixir-autogen, elixir-format
msgid "0 stops marking staff networks. Kept in memory only."
msgstr "0 lõpetab töötajate võrkude märkimise. Hoitakse ainult mälus."

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:331
#, elixir-autogen, elixir-format
msgid "Addresses in the network listed in the app's config (internal_networks)."
msgid_plural "Addresses in the %{count} networks listed in the app's config (internal_networks)."
msgstr[0] "Aadressid rakenduse konfiguratsioonis (internal_networks) loetletud võrgust."
msgstr[1] "Aadressid rakenduse konfiguratsioonis (internal_networks) loetletud %{count} võrgust."

#: lib/phoenix_kit_web_analytics/web/components.ex:92
#, elixir-autogen, elixir-format
msgid "Also count bot traffic (stored only when Settings record it)."
msgstr "Arvesta ka robotite liiklust (salvestatakse ainult siis, kui see on seadetes sisse lülitatud)."

#: lib/phoenix_kit_web_analytics/web/components.ex:76
#, elixir-autogen, elixir-format
msgid "Also count the traffic Settings leave out of the statistics: the site's own people and their networks."
msgstr "Arvesta ka liiklust, mille seaded statistikast välja jätavad: saidi enda inimesed ja nende võrgud."

#: lib/phoenix_kit_web_analytics/web/components.ex:95
#, elixir-autogen, elixir-format
msgid "Bots"
msgstr "Robotid"

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:382
#, elixir-autogen, elixir-format
msgid "Every visit from an address where a staff member signed in or was active within the hours below. Behind a mobile network, carrier-grade NAT or an office gateway one address is many people: a staff sign-in from a phone leaves out everyone sharing that address for those hours. Visits before the sign-in are not marked afterwards."
msgstr "Iga külastus aadressilt, kus töötaja allpool toodud tundide jooksul sisse logis või oli aktiivne. Mobiilsidevõrgu, operaatori NAT-i (CGNAT) või kontori lüüsi taga on ühel aadressil palju inimesi: töötaja sisselogimine telefonist jätab nendeks tundideks välja kõik, kes seda aadressi jagavad. Enne sisselogimist toimunud külastusi tagantjärele ei märgita."

#: lib/phoenix_kit_web_analytics/traffic_flags.ex:86
#, elixir-autogen, elixir-format
msgid "Internal network"
msgstr "Sisevõrk"

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:326
#, elixir-autogen, elixir-format
msgid "Leave out internal networks"
msgstr "Jäta sisevõrgud välja"

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:357
#, elixir-autogen, elixir-format
msgid "Leave out site staff"
msgstr "Jäta saidi töötajad välja"

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:379
#, elixir-autogen, elixir-format
msgid "Leave out staff networks"
msgstr "Jäta töötajate võrgud välja"

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:337
#, elixir-autogen, elixir-format
msgid "No networks are configured. List the office or VPN ranges in the app's config — config :phoenix_kit_web_analytics, internal_networks: [\"203.0.113.0/24\"] — not here: every settings change is kept in the activity log."
msgstr "Võrke pole seadistatud. Lisa kontori või VPN-i vahemikud rakenduse konfiguratsiooni — config :phoenix_kit_web_analytics, internal_networks: [\"203.0.113.0/24\"] — mitte siia: iga seadete muudatus jääb tegevuslogisse."

#: lib/phoenix_kit_web_analytics/web/components.ex:88
#: lib/phoenix_kit_web_analytics/web/session_live.ex:192
#, elixir-autogen, elixir-format
msgid "Own traffic"
msgstr "Oma liiklus"

#: lib/phoenix_kit_web_analytics/web/components.ex:102
#, elixir-autogen, elixir-format
msgid "Read from raw events: days older than the raw-event retention have no data here, rather than zero visits."
msgstr "Loetakse toorsündmustest: toorsündmuste säilitusajast vanemate päevade kohta pole siin andmeid — see ei tähenda null külastust."

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:360
#, elixir-autogen, elixir-format
msgid "Signed-in users holding one of the staff roles below — whichever role they are acting as. A visit that turns into a staff member's (a sign-in midway) is left out whole."
msgstr "Sisselogitud kasutajad, kellel on üks allpool toodud töötajarollidest — ükskõik millises rollis nad parasjagu tegutsevad. Külastus, mis muutub töötaja omaks (sisselogimine poole pealt), jäetakse välja tervikuna."

#: lib/phoenix_kit_web_analytics/traffic_flags.ex:87
#, elixir-autogen, elixir-format
msgid "Site staff"
msgstr "Saidi töötajad"

#: lib/phoenix_kit_web_analytics/traffic_flags.ex:88
#, elixir-autogen, elixir-format
msgid "Staff network"
msgstr "Töötajate võrk"

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:189
#: lib/phoenix_kit_web_analytics/web/settings_live.ex:392
#, elixir-autogen, elixir-format
msgid "Staff network, hours"
msgstr "Töötajate võrk, tundi"

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:188
#: lib/phoenix_kit_web_analytics/web/settings_live.ex:369
#, elixir-autogen, elixir-format
msgid "Staff roles"
msgstr "Töötajate rollid"

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:317
#, elixir-autogen, elixir-format
msgid "Visits by the site's own people are stored with a mark and left out of the statistics, alerts and recordings — nothing is deleted. Untick a kind to count it in again; a report shows it all with Own traffic. Only the mark is stored, never an address."
msgstr "Saidi enda inimeste külastused salvestatakse märgisega ja jäetakse statistikast, teavitustest ja salvestustest välja — midagi ei kustutata. Eemalda linnuke, et seda liiki taas arvestada; aruandes näitab kõike lüliti „Oma liiklus“. Salvestatakse ainult märgis, mitte kunagi aadress."

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:315
#, elixir-autogen, elixir-format
msgid "Your own traffic"
msgstr "Teie oma liiklus"

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:347
#, elixir-autogen, elixir-format
msgid "%{count} entry in internal_networks is not a network and is skipped."
msgid_plural "%{count} entries in internal_networks are not networks and are skipped."
msgstr[0] "%{count} kirje internal_networks'is ei ole võrk ja jäetakse vahele."
msgstr[1] "%{count} kirjet internal_networks'is ei ole võrgud ja jäetakse vahele."

#: lib/phoenix_kit_web_analytics/web/settings_live.ex:373
#, elixir-autogen, elixir-format
msgid "Comma-separated role names, e.g. Owner, Admin. Empty: no one counts as staff."
msgstr "Rollide nimed komaga eraldatult, nt Owner, Admin. Tühi väli: keegi ei ole töötaja."
